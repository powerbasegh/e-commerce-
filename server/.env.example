PORT=5000
# Single origin or comma-separated list, e.g.:
# CLIENT_URL=https://powerbase.onrender.com,https://www.powerbase.example
CLIENT_URL=http://localhost:5173
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=test
DB_SSL=true
DB_CA_CERT=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- Stock reservations -----------------------------------------------------
# Hours an unpaid order may hold its stock reservation before it is released
# and the order cancelled. Default 48.
RESERVATION_EXPIRY_HOURS=48
# How often the release sweep runs, in minutes. Set to 0 to disable.
RESERVATION_SWEEP_MINUTES=30

# --- Product image upload (optional) ----------------------------------------
# Leave blank to disable uploads; vendors can still paste an image URL.
# All three must be set for the upload endpoint to become available.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=powerbase/products

# --- Paystack payments ------------------------------------------------------
# Leave blank to disable online payment. The secret key stays server-side.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional override for tests; production should use Paystack's default API.
PAYSTACK_API_BASE_URL=https://api.paystack.co
# Public customer-facing site URL. Paystack redirects customers here after checkout.
# Example: https://powerbase-py5h.onrender.com
CLIENT_URL=http://localhost:5173
