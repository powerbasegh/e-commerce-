PORT=5000
# Single origin or comma-separated list, e.g.:
# CLIENT_URL=https://powerbase.onrender.com,https://www.powerbase.example
CLIENT_URL=http://localhost:5173
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=test
DB_SSL=true
DB_CA_CERT=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- Stock reservations -----------------------------------------------------
# Hours an unpaid order may hold its stock reservation before it is released
# and the order cancelled. Default 48.
RESERVATION_EXPIRY_HOURS=48
# How often the release sweep runs, in minutes. Set to 0 to disable.
RESERVATION_SWEEP_MINUTES=30

# --- Product image upload (optional) ----------------------------------------
# Leave blank to disable uploads; vendors can still paste an image URL.
# All three must be set for the upload endpoint to become available.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=powerbase/products

# --- Hubtel payments (optional) ---------------------------------------------
# Leave any of these blank to disable online payment — see
# server/src/config/hubtelConfig.js. Customers simply won't be able to start
# a Hubtel checkout; nothing else breaks.
# Client ID/Secret from your Hubtel Online Checkout API app (unity.hubtel.com).
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
# Your Hubtel merchant account number (payments settle here).
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
# A long random string PowerBase itself generates (e.g. `openssl rand -hex 32`)
# — never given to you by Hubtel. It's embedded in the callback URL handed to
# Hubtel at checkout time so only Hubtel's real callback can reach the
# webhook route; see server/src/controllers/webhookController.js.
HUBTEL_WEBHOOK_SECRET=
# Where this API is reachable from the public internet, so the callback URL
# sent to Hubtel resolves back here (e.g. https://api.powerbase.example).
PUBLIC_API_BASE_URL=
# Override only if Hubtel gives you a different Online Checkout base URL
# (e.g. a sandbox/test host) — defaults to the production endpoint.
HUBTEL_CHECKOUT_INITIATE_URL=
# Minutes an already-started checkout link is reused before a "Pay now"
# click starts a fresh one. Default 30.
HUBTEL_CHECKOUT_REUSE_MINUTES=30
